{
  "name": "@lemma/headless",
  "version": "1.0.0",
  "description": "Headless editor UI (slash menu, bubble menu, upload placeholders) for Lemma. Consumed from source by the web app.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "lint": "biome lint ./src",
    "format": "biome format ./src "
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@tiptap/core": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/suggestion": "3.19.0",
    "cmdk": "1.1.1",
    "jotai": "2.17.1",
    "tippy.js": "6.3.7",
    "tunnel-rat": "0.1.2"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsdown": "0.20.3",
    "typescript": "5.9.3"
  },
  "author": "Irere Emmanuel <hello@irere.dev>",
  "homepage": "https://lemma.new",
  "keywords": [
    "ai",
    "lemma",
    "editor",
    "markdown",
    "nextjs",
    "react"
  ],
  "exports": {
    ".": "./src/index.ts"
  }
}
