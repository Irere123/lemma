exports[`word/win-desktop-review.html snapshot 1`] = `
"{
  "droppedImages": 1,
  "content": [
    {"type":"paragraph","content":[{"type":"text","text":"Platform Review: Autumn Release"}]},
    {"type":"paragraph"},
    {
      "type": "heading",
      "attrs": {"level":1},
      "content": [{"type":"text","marks":[{"type":"textStyle","attrs":{"color":null}}],"text":"Summary"}]
    },
    {
      "type": "paragraph",
      "content": [
        {"type":"text","text":"The new build pipeline went live on "},
        {"type":"text","marks":[{"type":"bold"}],"text":"14 October"},
        {"type":"text","text":" and reduced cold-start time by roughly "},
        {"type":"text","marks":[{"type":"textStyle","attrs":{"color":"#C00000"}}],"text":"forty percent"},
        {"type":"footnoteReference","attrs":{"id":"fn-1"}},
        {"type":"text","text":". The migration finished "},
        {"type":"text","marks":[{"type":"textStyle","attrs":{"color":null}}],"text":"two days ahead of plan"},
        {"type":"text","text":", and error rates stayed flat across "},
        {"type":"text","marks":[{"type":"italic"}],"text":"all"},
        {"type":"text","text":" regions."}
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {"type":"text","text":"Two items still need attention: "},
        {"type":"text","marks":[{"type":"textStyle","attrs":{"color":null}},{"type":"highlight","attrs":{"color":"yellow"}}],"text":"the certificate rotation runbook"},
        {"type":"text","text":" and "},
        {"type":"text","marks":[{"type":"textStyle","attrs":{"color":null}},{"type":"highlight","attrs":{"color":"lime"}}],"text":"the on-call handover notes"},
        {"type":"text","text":". Older guidance on manual restarts is "},
        {"type":"text","marks":[{"type":"strike"}],"text":"still valid"},
        {"type":"text","text":" retired; see the "},
        {"type":"text","marks":[{"type":"link","attrs":{"href":"https://www.example.com/status/autumn-release","target":"_blank","rel":"noopener noreferrer nofollow","class":null,"title":null}}],"text":"status page"},
        {"type":"text","text":" for the current procedure."}
      ]
    },
    {"type":"paragraph"},
    {
      "type": "heading",
      "attrs": {"level":2},
      "content": [{"type":"text","text":"Changes since the last review"}]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [{"type":"text","text":"Search indexing moved to the shared queue."}]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [{"type":"text","text":"Backfill completed in every region."}]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {"type":"text","text":"Query latency is back under 80 ms at the 95th percentile."}
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {"type":"text","text":"The "},
                {"type":"text","marks":[{"type":"textStyle","attrs":{"color":null}}],"text":"déjà vu"},
                {"type":"text","text":" retry bug is fixed; CO"},
                {"type":"text","marks":[{"type":"subscript"}],"text":"2"},
                {"type":"text","text":" reporting now uses kWh"},
