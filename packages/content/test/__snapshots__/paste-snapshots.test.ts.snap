exports[`word/mac-m365-notes.html snapshot 1`] = `
"{
  "droppedImages": 1,
  "content": [
    {"type":"heading","attrs":{"level":1},"content":[{"type":"text","text":"Garden Club Minutes"}]},
    {
      "type": "paragraph",
      "content": [
        {"type":"text","text":"We agreed to move the "},
        {"type":"text","marks":[{"type":"bold"}],"text":"seed swap"},
        {"type":"text","text":" to the first Saturday of the month and to keep the "},
        {"type":"text","marks":[{"type":"italic"}],"text":"tool library"},
        {"type":"text","text":" open on weekday evenings. The treasurer reported a "},
        {"type":"text","marks":[{"type":"textStyle","attrs":{"color":"#00B050"}}],"text":"small surplus"},
        {"type":"text","text":" for the season."}
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [{"type":"text","text":"Order compost before the frost."}]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [{"type":"text","text":"Two pallets are enough for the north beds."}]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {"type":"text","marks":[{"type":"textStyle","attrs":{"color":null}},{"type":"highlight","attrs":{"color":"yellow"}}],"text":"Repair the greenhouse door"},
                {"type":"text","text":" before the open day."}
              ]
            }
          ]
        }
      ]
    },
    {"type":"paragraph"},
    {
      "type": "orderedList",
      "attrs": {"start":3,"type":null},
      "content": [
        {
          "type": "listItem",
          "content": [{"type":"paragraph","content":[{"type":"text","text":"Confirm the hall booking."}]}]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {"type":"text","text":"Print "},
                {"type":"text","marks":[{"type":"textStyle","attrs":{"color":null}},{"type":"highlight","attrs":{"color":"cyan"}}],"text":"forty"},
                {"type":"text","text":" flyers for the library noticeboard."}
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "table",
      "content": [
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {"colspan":1,"rowspan":1,"colwidth":null},
              "content": [
                {
                  "type": "paragraph",
                  "content": [{"type":"text","marks":[{"type":"bold"}],"text":"Task"}]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {"colspan":1,"rowspan":1,"colwidth":null},
              "content": [
                {
                  "type": "paragraph",
                  "content": [{"type":"text","marks":[{"type":"bold"}],"text":"Volunteer"}]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {"colspan":1,"rowspan":1,"colwidth":null},
              "content": [{"type":"paragraph","content":[{"type":"text","text":"Watering rota"}]}]
            },
            {
              "type": "tableCell",
              "attrs": {"colspan":1,"rowspan":1,"colwidth":null},
              "content": [{"type":"paragraph","content":[{"type":"text","text":"Whoever is free that week"}]}]
