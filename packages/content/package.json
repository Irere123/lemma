{
  "name": "@lemma/content",
  "private": true,
  "type": "module",
  "description": "Canonical content model shared by web, api, and email. '.' is zero-dependency and DOM-free (renderers, text, markdown); './schema' is the Tiptap document model; './yjs' maps it onto Yjs; './export' builds EPUB and DOCX manuscripts. All entries are Worker-safe.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./yjs": "./src/yjs.ts",
    "./markdown": "./src/markdown-parse.ts",
    "./export": "./src/export/index.ts"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@tiptap/core": "3.19.0",
    "@tiptap/extension-code": "3.19.0",
    "@tiptap/extension-code-block": "3.19.0",
    "@tiptap/extension-document": "3.19.0",
    "@tiptap/extension-highlight": "3.19.0",
    "@tiptap/extension-image": "3.19.0",
    "@tiptap/extension-link": "3.19.0",
    "@tiptap/extension-list": "3.19.0",
    "@tiptap/extension-mathematics": "3.19.0",
    "@tiptap/extension-subscript": "3.19.0",
    "@tiptap/extension-superscript": "3.19.0",
    "@tiptap/extension-table": "3.19.0",
    "@tiptap/extension-text-style": "3.19.0",
    "@tiptap/extension-unique-id": "3.19.0",
    "@tiptap/extension-youtube": "3.19.0",
    "@tiptap/extensions": "3.19.0",
    "@tiptap/pm": "3.19.0",
    "@tiptap/starter-kit": "3.19.0",
    "@tiptap/y-tiptap": "3.0.10",
    "katex": "0.16.28",
    "lib0": "0.2.119",
    "marked": "17.0.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "@types/bun": "1.3.6",
    "@xmldom/xmldom": "0.9.12",
    "fast-check": "4.10.2",
    "fflate": "0.8.3"
  }
}
